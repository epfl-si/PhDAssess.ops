                      "name": "4b4e7fa0-9846-4a8a-9ab3-f09b21e777c8"
                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "direction": "backward",
                      "editorMode": "code",
                      "expr": "{k8s_namespace_name=\"svc1394p-phd-assess\", kubernetes_container_name=~\"web-app\"} |~ \".*$filter.*\" | json | message != `` | message !~ `.*phd-assess:model:user.*` | line_format `web-app — {{.message}}`",
