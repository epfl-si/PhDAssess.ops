{
  "index_patterns": [
    "zeebe-record-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index.lifecycle.name": "zeebe-records-retention"
    },
    "mappings": {
      "properties": {
        "partitionId": {
          "type": "integer"
        },
        "position": {
          "type": "long"
        },
        "key": {
          "type": "long"
        },
        "timestamp": {
          "type": "date",
          "format": "epoch_millis"
        },
        "recordType": {
          "type": "keyword"
        },
        "intent": {
          "type": "keyword"
        },
        "rejectionType": {
          "type": "keyword"
        },
        "rejectionReason": {
          "type": "text"
        },
        "brokerVersion": {
          "type": "keyword"
        },
        "sourceRecordPosition": {
          "type": "long"
        },
        "operationReference": {
          "type": "long"
        },
        "value": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "priority": 100
}
